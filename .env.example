# LiveKit project shared by every tenant (rotate these if they were ever exposed).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram streaming STT
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_ENDPOINTING_MS=300

# Must match LIVEKIT_CAPTIONER_AGENT_NAME on the Laravel sites (default cx-captioner).
# CAPTIONER_AGENT_NAME=cx-captioner
# CAPTIONER_IDLE_PROCESSES=2
# CAPTIONER_LOAD_THRESHOLD=0.75
# CAPTIONER_MAX_STREAMS_PER_ROOM=25
# CAPTIONER_JOB_MEMORY_WARN_MB=500
# CAPTIONER_JOB_MEMORY_LIMIT_MB=1024
# CAPTIONER_DRAIN_TIMEOUT=600
